<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="110dp"
        android:paddingBottom="32dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="40dp">

                <!-- Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/badge_blue_bg">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/calculator"
                            tools:ignore="VisualLintContrast" />

                    </FrameLayout>

                    <TextView
                        android:id="@+id/header"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="@string/app_header"
                        android:textColor="#1F2430"
                        android:textSize="@dimen/text_header"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Height Label -->
                <TextView
                    android:id="@+id/height"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="@string/label_height"
                    android:textColor="#1F2430"
                    android:textSize="@dimen/text_label"
                    android:textStyle="bold" />

                <!-- Height Input -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/input_bg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="4dp">

                    <ImageView
                        android:id="@+id/height_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="10dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/height" />

                    <EditText
                        android:id="@+id/input_height"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="@string/hint_height"
                        android:importantForAutofill="no"
                        android:inputType="numberDecimal"
                        android:minHeight="48dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:textColor="#1F2430"
                        android:textColorHint="@color/hint_text"
                        android:textSize="@dimen/text_input"
                        tools:ignore="VisualLintTextFieldSize,VisualLintTouchTargetSize" />

                </LinearLayout>

                <!-- Weight Label -->
                <TextView
                    android:id="@+id/weight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="@string/label_weight"
                    android:textColor="#1F2430"
                    android:textSize="@dimen/text_label"
                    android:textStyle="bold" />

                <!-- Weight Input -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/input_bg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="4dp">

                    <ImageView
                        android:id="@+id/weight_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="10dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/weight" />

                    <EditText
                        android:id="@+id/input_weight"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="@string/hint_weight"
                        android:importantForAutofill="no"
                        android:inputType="numberDecimal"
                        android:minHeight="48dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:textColor="#1F2430"
                        android:textColorHint="@color/hint_text"
                        android:textSize="@dimen/text_input"
                        tools:ignore="VisualLintTextFieldSize,VisualLintTouchTargetSize" />

                </LinearLayout>

                <!-- BMI Label -->
                <TextView
                    android:id="@+id/bmi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="@string/label_bmi"
                    android:textColor="#1F2430"
                    android:textSize="@dimen/text_label"
                    android:textStyle="bold" />

                <!-- BMI Result -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/input_bg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="4dp">

                    <ImageView
                        android:id="@+id/bmi_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="10dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/bmi"
                        app:tint="@color/category_underweight" />

                    <TextView
                        android:id="@+id/input_bmi"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@null"
                        android:minHeight="48dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:textColor="#1F2430"
                        android:textSize="@dimen/text_result" />

                </LinearLayout>

                <!-- Status Label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="@string/label_status"
                    android:textColor="#1F2430"
                    android:textSize="@dimen/text_label"
                    android:textStyle="bold" />

                <!-- Status Result -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:background="@drawable/input_bg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="4dp">

                    <ImageView
                        android:id="@+id/status_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="10dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/status" />

                    <TextView
                        android:id="@+id/input_status"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@null"
                        android:minHeight="48dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:textColor="#1F2430"
                        android:textSize="@dimen/text_result" />

                </LinearLayout>

                <!-- Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="68dp"
                    android:gravity="center_horizontal"
                    android:orientation="horizontal">

                    <!-- Calculate Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/calculate2"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:backgroundTint="#4C6FF5"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:text="@string/btn_calculate"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="@dimen/text_button"
                        android:textStyle="bold"
                        app:cornerRadius="16dp"
                        tools:ignore="VisualLintButtonSize,VisualLintContrast" />

                    <!-- Clear Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/clear"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:backgroundTint="#C6CACA"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:text="@string/btn_clear"
                        android:textAllCaps="false"
                        android:textColor="@color/btn_clear_text"
                        android:textSize="@dimen/text_button"
                        android:textStyle="bold"
                        app:cornerRadius="16dp"
                        tools:ignore="VisualLintButtonSize" />

                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===================== BMI CATEGORIES ===================== -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="32dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Categories Title -->
                <TextView
                    android:id="@+id/categories"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:gravity="center"
                    android:text="@string/label_categories"
                    android:textColor="#1F2430"
                    android:textSize="@dimen/text_category_title"
                    android:hyphenationFrequency="full"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <!-- Underweight -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/category_bg_blue"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginBottom="4dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_person"
                            app:tint="@color/category_underweight" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/category_underweight"
                            android:textColor="@color/category_underweight"
                            android:textSize="@dimen/text_category"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:hyphenationFrequency="full"
                            android:text="@string/range_underweight"
                            android:textColor="@color/text_muted"
                            android:textSize="@dimen/text_category" />

                    </LinearLayout>

                    <!-- Healthy Weight -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/category_bg_green"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginBottom="4dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_person"
                            app:tint="@color/category_healthy" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/category_healthy"
                            android:textColor="@color/category_healthy"
                            android:textSize="@dimen/text_category"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:hyphenationFrequency="full"
                            android:text="@string/range_healthy"
                            android:textColor="@color/text_muted"
                            android:textSize="@dimen/text_category" />

                    </LinearLayout>

                    <!-- Overweight -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/category_bg_orange"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginBottom="4dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_person"
                            app:tint="@color/category_overweight" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/category_overweight"
                            android:textColor="@color/category_overweight"
                            android:textSize="@dimen/text_category"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:hyphenationFrequency="full"
                            android:text="@string/range_overweight"
                            android:textColor="@color/text_muted"
                            android:textSize="@dimen/text_category" />

                    </LinearLayout>

                    <!-- Obesity -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/category_bg_red"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginBottom="4dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_person"
                            app:tint="@color/category_obesity" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/category_obesity"
                            android:textColor="@color/category_obesity"
                            android:textSize="@dimen/text_category"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:hyphenationFrequency="full"
                            android:text="@string/range_obesity"
                            android:textColor="@color/text_muted"
                            android:textSize="@dimen/text_category" />

                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>